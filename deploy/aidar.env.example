# Install as /etc/aidar/aidar.env with mode 0600 and owner aidar:aidar.
# Generate secrets locally; never commit populated values.
AIDAR_HOST=127.0.0.1
PORT=39740
AIDAR_BASE_URL=https://submityour.work
AIDAR_DATABASE_PATH=/var/lib/aidar/aidar.sqlite
AIDAR_TOKEN_HMAC_SECRET=
AIDAR_ADMIN_TOKEN_HASH=
AIDAR_GITHUB_MODE=live

GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY_PATH=/etc/aidar/github-app.pem
GITHUB_INSTALLATION_ID=
GITHUB_ORG=NeurIPS2026-AIDaR
GITHUB_API_VERSION=2026-03-10
GITHUB_PUBLIC_ARCHIVE_REPO=aidar-2026-submissions

# Conservative invited-pilot limits.
MAX_UPLOAD_BYTES=104857600
MAX_UNPACKED_BYTES=262144000
MAX_FILE_BYTES=26214400
MAX_FILE_COUNT=5000
MAX_PATH_LENGTH=240
MAX_RESPONSE_BYTES=65536
