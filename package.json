{
  "name": "aidar-submission-system",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/NeurIPS2026-AIDaR/submission-kit.git"
  },
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "bin": {
    "aidar": "dist/src/cli/aidar.js",
    "aidar-admin": "dist/src/cli/aidar-admin.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepare": "npm run build",
    "check": "tsc -p tsconfig.json --noEmit",
    "start": "node dist/src/server.js",
    "dev": "node --import tsx src/server.ts",
    "aidar": "node --import tsx src/cli/aidar.ts",
    "aidar-admin": "node --import tsx src/cli/aidar-admin.ts",
    "github-app:register": "node --import tsx scripts/register-github-app.ts",
    "live:configure": "node --import tsx scripts/configure-live.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:pilot": "node --import tsx scripts/local-pilot.ts",
    "test:live": "node --import tsx scripts/live-smoke.ts"
  },
  "dependencies": {
    "@fastify/multipart": "^9.2.1",
    "@octokit/auth-app": "^8.1.0",
    "@octokit/rest": "^22.0.0",
    "commander": "^14.0.0",
    "dotenv": "^17.2.1",
    "fastify": "^5.4.0",
    "tar-stream": "^3.1.7",
    "yaml": "^2.8.0",
    "zod": "^4.0.14"
  },
  "devDependencies": {
    "@types/node": "^22.17.0",
    "@types/tar-stream": "^3.1.4",
    "tsx": "^4.20.3",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
